# Server Configuration
PORT=5000
NODE_ENV=production
# Frontend URL(s) - e.g. https://your-app.vercel.app or comma-separated
CLIENT_URL=https://your-frontend.vercel.app

# Aiven MySQL Database Configuration
# Option A: Full Connection URI from Aiven Service Overview (Recommended)
# DATABASE_URL=mysql://avnadmin:your_password@mysql-xxxx-xxxx.a.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Option B: Individual Parameters from Aiven Service Overview
DB_HOST=mysql-xxxx-xxxx.a.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=defaultdb
DB_SSL=true

# Security & Authentication
# Min 32 characters random string
JWT_SECRET=your_jwt_secret_key_min32chars
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
